# Copy to .env and fill in values:
#   cp .env.example .env
# Or run ./setup.sh which creates .env and generates secrets.

# --- Public URLs / hosts (change these on another server) ---
NEXTCLOUD_PORT=8082
NEXTCLOUD_URL=http://localhost:8082
NEXTCLOUD_TRUSTED_DOMAINS=localhost
NC_DOMAIN=localhost

COLLABORA_DOMAIN=localhost:9980
TALK_HOST=localhost
TALK_SIGNALING_PORT=8181
TALK_TURN_PORT=3478
# aio-talk → Nextcloud TLS check (true for local http)
TALK_SKIP_CERT_VERIFY=true

TZ=Europe/Berlin

# --- Database ---
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- Nextcloud admin (used only on first install) ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me-admin-password

# --- Collabora admin console ---
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=change-me-collabora-password

# --- Talk HPB secrets (openssl rand -hex 32) ---
TURN_SECRET=
SIGNALING_SECRET=
INTERNAL_SECRET=
