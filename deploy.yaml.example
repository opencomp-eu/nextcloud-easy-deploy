# nextcloud-easy-deploy — operator configuration
# Copy to deploy.yaml and run: bash apply.sh   (or run: bash wizard.sh)

nextcloud:
  # Public hostname of Nextcloud
  domain: cloud.example.com
  image: docker.io/library/nextcloud
  tag: "34.0.5-apache"
  # Holds html/ (Nextcloud code, config, apps), data/ (user files), postgres/
  data_dir: /var/lib/nextcloud
  # Local break-glass administrator (password in .nextcloud-easy-deploy/secrets.yaml).
  # With Kanidm sign-in, reach the local login form at https://<domain>/login?direct=1
  admin_user: admin
  default_phone_region: ""
  # Update installed Nextcloud apps from the app store on every apply.
  update_apps: true
  # Apps enabled on apply (from the app store unless bundled with Nextcloud).
  apps:
    - calendar
    - contacts
    - deck
    - mail
    - spreed
    - richdocuments
  php_memory_limit: 1G
  php_upload_limit: 16G

postgres:
  image: docker.io/library/postgres
  tag: "16-alpine"

redis:
  image: docker.io/library/redis
  tag: "7.4.12-alpine"

# Collabora Online (documents, spreadsheets, presentations in the browser)
office:
  enabled: true
  domain: office.example.com
  image: docker.io/collabora/code
  tag: "26.04.5.2.1"

# Nextcloud Talk high-performance backend (signaling, Janus, TURN).
# Signaling is served at https://<nextcloud.domain>/standalone-signaling/.
# TURN listens on the host; open the port (TCP and UDP) in the firewall.
talk:
  enabled: true
  image: ghcr.io/nextcloud-releases/aio-talk
  tag: "20261021_180331"
  turn_port: 3478

# auth.oidc.provider: kanidm — written by easydeploy-engine (same VPS).
# People sign in through Kanidm; members of the Kanidm group nextcloud-admins
# become Nextcloud administrators. Set auth.oidc.managed: false to keep local
# Nextcloud accounts only.
# auth:
#   oidc:
#     managed: true

# Nextcloud Mail against Stalwart — written by easydeploy-engine (same VPS).
# Every user whose email is on the Stalwart domain gets a mailbox in Nextcloud
# Mail without entering a password. Set mail.managed: false to configure Mail
# accounts by hand.
# mail:
#   managed: true

proxy:
  type: caddy
  # standalone — this kit runs its own Caddy on :443 (single-service VPS)
  # integrate — join easydeploy-net; easydeploy-engine owns Caddy (multi-service VPS)
  mode: standalone
  integrate:
    network: easydeploy-net

# Optional Borg backup repository and automatic schedule.
# Backups include this file, generated state, Nextcloud code/config/apps,
# user files, and a PostgreSQL dump.
backup:
  enabled: false
  repository:
    type: local
    path: /var/backups/nextcloud
    # For SFTP repositories, set type, host, user, path, and ssh_key_path.
    # host: backup.example.com
    # user: borg
    # port: 22
    # ssh_key_path: /root/.ssh/borg_backup
    # host_key_check: true
    encryption: repokey
  schedule:
    enabled: false
    calendar: "*-*-* 03:00:00"
    persistent: true
  retention:
    keep_daily: 7
    keep_weekly: 4
    keep_monthly: 6
    keep_yearly: 0
